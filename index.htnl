<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#020304">

<title>CONVERGENCE</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#020304;
    color:white;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
    overflow-x:hidden;
}

body.locked{
    overflow:hidden;
}

/* =========================
   FILM GRAIN
========================= */

body::after{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:9998;
    opacity:.055;
    background-image:
        repeating-radial-gradient(
            circle at 0 0,
            transparent 0,
            #fff 1px,
            transparent 2px
        );
    background-size:5px 5px;
}

/* =========================
   START SCREEN
========================= */

#startScreen{
    position:fixed;
    inset:0;
    z-index:10000;
    background:#020304;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:opacity 1.1s ease, visibility 1.1s ease;
}

#startScreen.hide{
    opacity:0;
    visibility:hidden;
}

.start-inner{
    text-align:center;
    width:90%;
}

.start-code{
    font-size:10px;
    letter-spacing:4px;
    color:#687078;
    margin-bottom:28px;
}

.start-title{
    font-size:11vw;
    font-weight:300;
    letter-spacing:.16em;
    margin-right:-.16em;
}

.start-sub{
    margin-top:18px;
    color:#7f878d;
    font-size:11px;
    letter-spacing:2px;
}

.enter-btn{
    margin-top:55px;
    border:1px solid #3b4247;
    background:transparent;
    color:white;
    padding:15px 30px;
    border-radius:40px;
    font-size:11px;
    letter-spacing:3px;
    cursor:pointer;
}

.enter-btn:active{
    transform:scale(.97);
}

/* =========================
   BOOT SCREEN
========================= */

#boot{
    position:fixed;
    inset:0;
    z-index:9000;
    background:#020304;
    padding:10vh 7vw;
    display:none;
    flex-direction:column;
    justify-content:center;
}

.boot-line{
    font-family:monospace;
    font-size:13px;
    color:#9da6ad;
    margin:7px 0;
    opacity:0;
    transform:translateY(5px);
    transition:.4s;
}

.boot-line.show{
    opacity:1;
    transform:none;
}

.boot-line.green{
    color:#78f6b4;
}

.boot-line.red{
    color:#ff7272;
}

/* =========================
   MAIN
========================= */

#main{
    opacity:0;
    transition:opacity 1.5s ease;
}

#main.visible{
    opacity:1;
}

section{
    position:relative;
}

/* =========================
   HERO
========================= */

.hero{
    height:100svh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    background:#020304;
}

.hero-content{
    position:relative;
    z-index:3;
    width:85%;
}

.micro{
    font-size:10px;
    letter-spacing:4px;
    color:#707980;
    text-transform:uppercase;
}

.hero h1{
    font-size:13vw;
    line-height:.88;
    font-weight:300;
    letter-spacing:-4px;
    margin-top:22px;
}

.hero h1 span{
    display:block;
}

.hero-bottom{
    position:absolute;
    bottom:40px;
    left:7vw;
    right:7vw;
    display:flex;
    justify-content:space-between;
    color:#646d74;
    font-size:9px;
    letter-spacing:2px;
}

.scroll-indicator{
    width:1px;
    height:45px;
    background:#555;
    overflow:hidden;
}

.scroll-indicator::after{
    content:"";
    width:1px;
    height:18px;
    background:white;
    display:block;
    animation:scrollLine 1.7s infinite;
}

@keyframes scrollLine{
    0%{transform:translateY(-20px)}
    100%{transform:translateY(50px)}
}

/* =========================
   TEXT SCENES
========================= */

.scene{
    min-height:100svh;
    padding:14vh 7vw;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.scene.dark{
    background:#020304;
}

.scene-number{
    font-size:10px;
    color:#5e676d;
    letter-spacing:3px;
    margin-bottom:35px;
}

.big-copy{
    font-size:12vw;
    font-weight:300;
    line-height:1;
    letter-spacing:-2px;
}

.big-copy.small{
    font-size:9vw;
}

.muted{
    color:#727a80;
}

/* =========================
   FULL IMAGE
========================= */

.photo-scene{
    min-height:110svh;
    background:#050607;
    padding:10vh 0;
}

.photo-label{
    padding:0 7vw;
    margin-bottom:20px;
}

.label-top{
    font-size:9px;
    color:#687077;
    letter-spacing:3px;
}

.label-main{
    margin-top:8px;
    font-family:monospace;
    font-size:13px;
}

.full-photo{
    width:100%;
    min-height:72svh;
    object-fit:cover;
    display:block;
    filter:saturate(.85);
}

.photo-data{
    padding:17px 7vw;
    display:flex;
    justify-content:space-between;
    color:#626a70;
    font-family:monospace;
    font-size:9px;
}

/* =========================
   SPLIT WORLD
========================= */

.compare{
    background:#030405;
    padding:16vh 0;
}

.compare-title{
    padding:0 7vw 8vh;
}

.compare-title h2{
    font-size:11vw;
    font-weight:300;
}

.compare-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:2px;
}

.compare-card{
    height:60svh;
    position:relative;
    overflow:hidden;
}

.compare-card img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.compare-card::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 45%,rgba(0,0,0,.8));
}

.compare-name{
    position:absolute;
    z-index:2;
    bottom:18px;
    left:15px;
    font-size:9px;
    letter-spacing:2px;
}

.analysis{
    padding:7vh 7vw;
    font-family:monospace;
}

.analysis-row{
    display:flex;
    justify-content:space-between;
    border-bottom:1px solid #202427;
    padding:20px 0;
    font-size:12px;
}

.fail{
    color:#ff6d6d;
}

.pass{
    color:#64e9a3;
}

/* =========================
   DISTANCE
========================= */

.distance-section{
    min-height:100svh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    background:#020304;
    text-align:center;
    padding:10vh 6vw;
}

.distance-label{
    font-size:9px;
    letter-spacing:4px;
    color:#657078;
}

.distance-number{
    font-size:23vw;
    font-weight:200;
    line-height:.9;
    margin-top:25px;
}

.distance-unit{
    color:#6a737a;
    font-size:12px;
    letter-spacing:4px;
    margin-top:15px;
}

.signal-line{
    position:relative;
    width:75%;
    height:1px;
    background:#2b3034;
    margin-top:70px;
}

.dot{
    position:absolute;
    width:10px;
    height:10px;
    border-radius:50%;
    background:white;
    top:-4px;
}

.dot.left{
    left:0;
}

.dot.right{
    right:0;
}

.signal-line::after{
    content:"";
    position:absolute;
    left:5px;
    right:5px;
    height:1px;
    background:linear-gradient(90deg,#fff,#555,#fff);
    opacity:.4;
}

.location-names{
    width:78%;
    display:flex;
    justify-content:space-between;
    margin-top:16px;
    font-size:9px;
    color:#697178;
    letter-spacing:2px;
}

/* =========================
   MAP
========================= */

.map-scene{
    background:#050708;
    padding:12vh 0;
}

.map-header{
    padding:0 7vw 30px;
}

.map-header h2{
    font-size:10vw;
    font-weight:300;
}

.map-image{
    width:100%;
    display:block;
    filter:brightness(.75) saturate(.75);
}

.map-overlay{
    margin:0 7vw;
    transform:translateY(-30px);
    background:rgba(10,13,15,.92);
    backdrop-filter:blur(18px);
    border:1px solid #252b2f;
    padding:22px;
    border-radius:18px;
}

.map-overlay small{
    color:#697278;
    font-size:9px;
    letter-spacing:2px;
}

.map-overlay strong{
    display:block;
    margin-top:9px;
    font-size:28px;
    font-weight:300;
}

/* =========================
   PERSON REVEAL
========================= */

human-scene{}

.human-scene{
    min-height:100svh;
    position:relative;
    overflow:hidden;
}

.human-scene img{
    width:100%;
    height:100svh;
    object-fit:cover;
}

.human-gradient{
    position:absolute;
    inset:0;
    background:linear-gradient(
        180deg,
        rgba(0,0,0,.05),
        rgba(0,0,0,.1) 40%,
        rgba(0,0,0,.9)
    );
}

.human-text{
    position:absolute;
    left:7vw;
    right:7vw;
    bottom:9vh;
    z-index:2;
}

.human-text small{
    font-size:9px;
    letter-spacing:3px;
    color:#aaa;
}

.human-text h2{
    margin-top:14px;
    font-size:10vw;
    line-height:1;
    font-weight:300;
}

/* =========================
   CONVERGENCE STATEMENT
========================= */

.statement{
    min-height:120svh;
    padding:15vh 7vw;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.statement p{
    font-size:11vw;
    line-height:1.05;
    font-weight:300;
    margin:18px 0;
}

.statement .fade-text{
    color:#4f575c;
}

/* =========================
   COUNTDOWN
========================= */

.countdown-section{
    min-height:110svh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:10vh 5vw;
    background:#030405;
}

.count-wrap{
    width:100%;
}

.count-small{
    color:#6b747a;
    font-size:9px;
    letter-spacing:4px;
}

.date{
    font-size:13vw;
    font-weight:200;
    line-height:1;
    margin:30px 0 8px;
}

.time-big{
    font-size:19vw;
    font-weight:200;
}

.count-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:7px;
    margin-top:65px;
}

.count-box{
    border:1px solid #202528;
    border-radius:12px;
    padding:20px 3px;
}

.count-box strong{
    display:block;
    font-size:7vw;
    font-weight:300;
}

.count-box span{
    display:block;
    margin-top:7px;
    color:#626c72;
    font-size:7px;
    letter-spacing:1px;
}

/* =========================
   DISTANCE COLLAPSE
========================= */

.closing{
    min-height:100svh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.closing-number{
    font-size:28vw;
    font-weight:200;
}

.closing small{
    display:block;
    color:#687177;
    letter-spacing:4px;
}

/* =========================
   FINAL REVEAL
========================= */

.pre-final{
    min-height:100svh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:8vw;
    background:#020304;
}

.pre-final-line{
    font-size:11vw;
    font-weight:300;
    line-height:1.07;
}

.continue-btn{
    width:max-content;
    margin-top:60px;
    padding:15px 25px;
    border-radius:40px;
    border:1px solid #41484c;
    color:white;
    background:none;
    font-size:10px;
    letter-spacing:3px;
}

.final{
    min-height:100svh;
    position:relative;
    display:none;
    background:#000;
    overflow:hidden;
}

.final.show{
    display:block;
    animation:finalAppear 1.7s ease;
}

@keyframes finalAppear{
    from{opacity:0}
    to{opacity:1}
}

.final img{
    width:100%;
    height:100svh;
    object-fit:cover;
}

.final-overlay{
    position:absolute;
    inset:0;
    background:
        linear-gradient(
            180deg,
            rgba(0,0,0,.05),
            rgba(0,0,0,.05) 45%,
            rgba(0,0,0,.92)
        );
}

.final-copy{
    position:absolute;
    z-index:3;
    bottom:8vh;
    left:7vw;
    right:7vw;
}

.final-small{
    font-size:9px;
    letter-spacing:4px;
    color:#bbb;
}

.final-title{
    margin-top:18px;
    font-family:Georgia,"Times New Roman",serif;
    font-size:13vw;
    line-height:.96;
    font-weight:400;
}

.final-date{
    margin-top:25px;
    font-size:12px;
    letter-spacing:3px;
    color:#ddd;
}

/* =========================
   END
========================= */

.end{
    padding:15vh 7vw 12vh;
    text-align:center;
    color:#525a5f;
    font-size:9px;
    letter-spacing:3px;
    background:#000;
}

/* =========================
   REVEAL ANIMATIONS
========================= */

.reveal{
    opacity:0;
    transform:translateY(40px);
    transition:
        opacity 1.1s ease,
        transform 1.1s ease;
}

.reveal.visible{
    opacity:1;
    transform:none;
}

@media(min-width:700px){

    body{
        background:#111;
    }

    #main,
    #boot{
        max-width:520px;
        margin:auto;
        left:50%;
        transform:translateX(-50%);
        width:100%;
    }

    #startScreen .start-inner{
        max-width:520px;
    }

    .start-title{
        font-size:55px;
    }

    .hero h1{
        font-size:68px;
    }

    .big-copy{
        font-size:58px;
    }

    .statement p{
        font-size:55px;
    }

    .distance-number{
        font-size:120px;
    }

    .date{
        font-size:64px;
    }

    .time-big{
        font-size:95px;
    }

    .final-title{
        font-size:68px;
    }

}

</style>
</head>

<body class="locked">

<!-- =====================
     START
===================== -->

<div id="startScreen">

    <div class="start-inner">

        <div class="start-code">
            PRIVATE TRANSMISSION
        </div>

        <div class="start-title">
            CONVERGENCE
        </div>

        <div class="start-sub">
            CASE 26.08
        </div>

        <button class="enter-btn" onclick="startExperience()">
            ACCESS
        </button>

    </div>

</div>


<!-- =====================
     BOOT
===================== -->

<div id="boot">

    <div class="boot-line">INITIALISING SYSTEM...</div>
    <div class="boot-line">SEARCHING FOR ACTIVE SIGNALS...</div>
    <div class="boot-line green">SIGNAL A DETECTED.</div>
    <div class="boot-line green">SIGNAL B DETECTED.</div>
    <div class="boot-line">VERIFYING LOCATIONS...</div>
    <div class="boot-line red">DISTANCE ANOMALY DETECTED.</div>
    <div class="boot-line">BEGINNING ANALYSIS...</div>

</div>


<!-- =====================
     MAIN
===================== -->

<main id="main">


<!-- HERO -->

<section class="hero">

    <div class="hero-content">

        <div class="micro">
            Tracking session active
        </div>

        <h1>
            <span>TWO</span>
            <span>SIGNALS.</span>
        </h1>

    </div>

    <div class="hero-bottom">

        <span>SESSION 26.08</span>

        <div class="scroll-indicator"></div>

        <span>SCROLL</span>

    </div>

</section>


<!-- SIGNAL A -->

<section class="scene dark">

    <div class="reveal">

        <div class="scene-number">
            SIGNAL / A
        </div>

        <div class="big-copy">
            Location<br>
            confirmed.
        </div>

    </div>

</section>


<section class="photo-scene">

    <div class="photo-label reveal">

        <div class="label-top">
            SOURCE A
        </div>

        <div class="label-main">
            AEGEAN SEA
        </div>

    </div>

    <img
        class="full-photo"
        src="1F7A7FB2-E8F3-4EBE-8725-3AB558976914.jpeg"
        alt=""
    >

    <div class="photo-data">
        <span>ENVIRONMENT: WARM</span>
        <span>STATUS: ACTIVE</span>
    </div>

</section>


<section class="photo-scene">

    <div class="photo-label reveal">

        <div class="label-top">
            SOURCE A / SECOND CAPTURE
        </div>

        <div class="label-main">
            KEA
        </div>

    </div>

    <img
        class="full-photo"
        src="922F5EB6-AA33-4741-96A5-6FEFA51397E2.jpeg"
        alt=""
    >

    <div class="photo-data">
        <span>SEA LEVEL</span>
        <span>VISIBILITY: CLEAR</span>
    </div>

</section>


<!-- SIGNAL B -->

<section class="scene dark">

    <div class="reveal">

        <div class="scene-number">
            SIGNAL / B
        </div>

        <div class="big-copy">
            Second location<br>
            confirmed.
        </div>

    </div>

</section>


<section class="photo-scene">

    <div class="photo-label reveal">

        <div class="label-top">
            SOURCE B
        </div>

        <div class="label-main">
            NORWAY
        </div>

    </div>

    <img
        class="full-photo"
        src="9823f1d3-13a4-4301-b648-ea9205029009.jpeg"
        alt=""
    >

    <div class="photo-data">
        <span>ENVIRONMENT: COLD</span>
        <span>STATUS: ACTIVE</span>
    </div>

</section>


<section class="photo-scene">

    <div class="photo-label reveal">

        <div class="label-top">
            SOURCE B / SECOND CAPTURE
        </div>

        <div class="label-main">
            FJORD SYSTEM
        </div>

    </div>

    <img
        class="full-photo"
        src="fb362e76-2367-404b-b342-bcd638a68bcf.jpeg"
        alt=""
    >

    <div class="photo-data">
        <span>WEATHER: CLOUDY</span>
        <span>VISIBILITY: VARIABLE</span>
    </div>

</section>


<!-- COMPARISON -->

<section class="compare">

    <div class="compare-title reveal">

        <div class="micro">
            SYSTEM ANALYSIS
        </div>

        <h2>
            Comparing<br>
            environments.
        </h2>

    </div>


    <div class="compare-grid">

        <div class="compare-card">
            <img src="1F7A7FB2-E8F3-4EBE-8725-3AB558976914.jpeg">
            <div class="compare-name">SIGNAL A</div>
        </div>

        <div class="compare-card">
            <img src="9823f1d3-13a4-4301-b648-ea9205029009.jpeg">
            <div class="compare-name">SIGNAL B</div>
        </div>

    </div>


    <div class="analysis reveal">

        <div class="analysis-row">
            <span>WEATHER</span>
            <span class="fail">NO MATCH</span>
        </div>

        <div class="analysis-row">
            <span>LANDSCAPE</span>
            <span class="fail">NO MATCH</span>
        </div>

        <div class="analysis-row">
            <span>TEMPERATURE</span>
            <span class="fail">NO MATCH</span>
        </div>

        <div class="analysis-row">
            <span>COUNTRY</span>
            <span class="fail">NO MATCH</span>
        </div>

        <div class="analysis-row">
            <span>TRAJECTORY</span>
            <span class="pass">ANALYSING...</span>
        </div>

    </div>

</section>


<!-- DISTANCE -->

<section class="distance-section">

    <div class="reveal">

        <div class="distance-label">
            DISTANCE BETWEEN SIGNALS
        </div>

        <div class="distance-number">
            2911
        </div>

        <div class="distance-unit">
            KILOMETRES
        </div>

    </div>


    <div class="signal-line reveal">
        <div class="dot left"></div>
        <div class="dot right"></div>
    </div>

    <div class="location-names reveal">
        <span>SIGNAL A</span>
        <span>SIGNAL B</span>
    </div>

</section>


<!-- MAP -->

<section class="map-scene">

    <div class="map-header reveal">

        <div class="micro">
            LIVE LOCATION DATA
        </div>

        <h2>
            Signal B<br>
            identified.
        </h2>

    </div>

    <img
        class="map-image"
        src="IMG_3102.png"
        alt=""
    >

    <div class="map-overlay reveal">

        <small>
            VERIFIED POSITION
        </small>

        <strong>
            2,911 km away
        </strong>

    </div>

</section>


<!-- PEOPLE REVEAL -->

<section class="scene dark">

    <div class="reveal">

        <div class="scene-number">
            NEW INFORMATION
        </div>

        <div class="big-copy small">
            The signals<br>
            aren't places.
        </div>

    </div>

</section>


<section class="human-scene">

    <img
        src="CC8A9D14-C4E0-4317-8BA9-B3F60C1AEE43.jpeg"
        alt=""
    >

    <div class="human-gradient"></div>

    <div class="human-text reveal">

        <small>
            SIGNAL A
        </small>

        <h2>
            One person.<br>
            One journey.
        </h2>

    </div>

</section>


<section class="human-scene">

    <img
        src="adc188c4-2285-4662-be31-453346f029fa.jpeg"
        alt=""
    >

    <div class="human-gradient"></div>

    <div class="human-text reveal">

        <small>
            SIGNAL B
        </small>

        <h2>
            Another person.<br>
            Another journey.
        </h2>

    </div>

</section>


<!-- THE TURN -->

<section class="statement">

    <div class="reveal">

        <p class="fade-text">
            Different weather.
        </p>

        <p class="fade-text">
            Different countries.
        </p>

        <p class="fade-text">
            Different views.
        </p>

        <p class="fade-text">
            Different journeys.
        </p>

    </div>

</section>


<section class="scene dark">

    <div class="reveal">

        <div class="scene-number">
            TRAJECTORY ANALYSIS COMPLETE
        </div>

        <div class="big-copy small">
            Unexpected<br>
            result.
        </div>

    </div>

</section>


<section class="scene dark">

    <div class="reveal">

        <div class="big-copy small muted">
            Both signals<br>
            are heading...
        </div>

    </div>

</section>


<section class="scene dark">

    <div class="reveal">

        <div class="big-copy">
            to the<br>
            exact same<br>
            point.
        </div>

    </div>

</section>


<!-- COUNTDOWN -->

<section class="countdown-section">

    <div class="count-wrap reveal">

        <div class="count-small">
            ESTIMATED CONVERGENCE
        </div>

        <div class="date">
            26 AUG
        </div>

        <div class="time-big">
            18:00
        </div>


        <div class="count-grid">

            <div class="count-box">
                <strong id="days">00</strong>
                <span>DAYS</span>
            </div>

            <div class="count-box">
                <strong id="hours">00</strong>
                <span>HOURS</span>
            </div>

            <div class="count-box">
                <strong id="minutes">00</strong>
                <span>MIN</span>
            </div>

            <div class="count-box">
                <strong id="seconds">00</strong>
                <span>SEC</span>
            </div>

        </div>

    </div>

</section>


<!-- DISTANCE COLLAPSE -->

<section class="closing">

    <div class="reveal">

        <small>
            FINAL DISTANCE
        </small>

        <div class="closing-number">
            0
        </div>

        <small>
            KM
        </small>

    </div>

</section>


<section class="scene dark">

    <div class="reveal">

        <div class="scene-number">
            ANALYSIS COMPLETE
        </div>

        <div class="big-copy small">
            The places<br>
            were never<br>
            the story.
        </div>

    </div>

</section>


<!-- PRE FINAL -->

<section class="pre-final">

    <div class="reveal">

        <div class="pre-final-line">
            Every photo<br>
            before this<br>
            was taken<br>
            while we<br>
            were apart.
        </div>

        <button
            class="continue-btn"
            onclick="showFinal()"
        >
            CONTINUE
        </button>

    </div>

</section>


<!-- FINAL -->

<section class="final" id="final">

    <img
        src="3ea6e81d-9d50-46bf-a6c3-39a0db4563c6.jpeg"
        alt=""
    >

    <div class="final-overlay"></div>


    <div class="final-copy">

        <div class="final-small">
            END OF TRANSMISSION
        </div>

        <div class="final-title">
            See you<br>
            soon.
        </div>

        <div class="final-date">
            26 AUGUST — 18:00
        </div>

    </div>

</section>


<div class="end">
    CONVERGENCE / 26.08
</div>


</main>


<script>

/* ==========================================
   START EXPERIENCE
========================================== */

function startExperience(){

    const start = document.getElementById("startScreen");
    const boot = document.getElementById("boot");

    start.classList.add("hide");

    setTimeout(()=>{

        boot.style.display="flex";

        const lines = document.querySelectorAll(".boot-line");

        lines.forEach((line,index)=>{

            setTimeout(()=>{

                line.classList.add("show");
                tinyBeep(index);

            }, index * 650);

        });


        setTimeout(()=>{

            boot.style.opacity="0";
            boot.style.transition="opacity 1s";

            setTimeout(()=>{

                boot.style.display="none";

                document.getElementById("main")
                    .classList.add("visible");

                document.body.classList.remove("locked");

            },1000);

        }, lines.length * 650 + 800);


    },900);

}


/* ==========================================
   SMALL CINEMATIC SYSTEM SOUNDS

   These are generated in the browser.
   No audio file is needed.
========================================== */

function tinyBeep(index){

    try{

        const AudioContext =
            window.AudioContext ||
            window.webkitAudioContext;

        const ctx = new AudioContext();

        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();

        oscillator.connect(gain);
        gain.connect(ctx.destination);

        oscillator.frequency.value =
            index === 5 ? 180 : 330 + index*18;

        oscillator.type="sine";

        gain.gain.setValueAtTime(.035,ctx.currentTime);

        gain.gain.exponentialRampToValueAtTime(
            .001,
            ctx.currentTime+.08
        );

        oscillator.start();
        oscillator.stop(ctx.currentTime+.08);

    }catch(e){}

}


/* ==========================================
   SCROLL REVEAL
========================================== */

const observer = new IntersectionObserver(

    entries=>{

        entries.forEach(entry=>{

            if(entry.isIntersecting){
                entry.target.classList.add("visible");
            }

        });

    },

    {
        threshold:.18
    }

);


document
    .querySelectorAll(".reveal")
    .forEach(el=>observer.observe(el));


/* ==========================================
   LIVE COUNTDOWN

   Target:
   26 August 2026
   18:00 Greece time
========================================== */

const reunion =
    new Date("2026-08-26T18:00:00+03:00");


function updateCountdown(){

    const now = new Date();

    let diff = reunion - now;

    if(diff <= 0){

        document.getElementById("days").innerText="00";
        document.getElementById("hours").innerText="00";
        document.getElementById("minutes").innerText="00";
        document.getElementById("seconds").innerText="00";

        return;

    }


    const days =
        Math.floor(diff / (1000*60*60*24));

    diff %= (1000*60*60*24);


    const hours =
        Math.floor(diff / (1000*60*60));

    diff %= (1000*60*60);


    const minutes =
        Math.floor(diff / (1000*60));

    diff %= (1000*60);


    const seconds =
        Math.floor(diff / 1000);


    document.getElementById("days")
        .innerText =
        String(days).padStart(2,"0");

    document.getElementById("hours")
        .innerText =
        String(hours).padStart(2,"0");

    document.getElementById("minutes")
        .innerText =
        String(minutes).padStart(2,"0");

    document.getElementById("seconds")
        .innerText =
        String(seconds).padStart(2,"0");

}


updateCountdown();

setInterval(updateCountdown,1000);


/* ==========================================
   FINAL REVEAL
========================================== */

function showFinal(){

    const final =
        document.getElementById("final");

    final.classList.add("show");

    setTimeout(()=>{

        final.scrollIntoView({
            behavior:"smooth",
            block:"start"
        });

    },100);

}

</script>

</body>
</html>